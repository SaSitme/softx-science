  "metric_registry": {
    "stabilized_PCE": "(?:stabili[sz]ed|steady[- ]state(?: output)?)\\s+(?:PCE|(?:power conversion )?efficiency)",
    "PCE": "PCE|power conversion efficiency|[ηɳ]",
    "Voc": "V[ _]*[oₒ][c꜀]|open[- ]circuit voltage",
    "Jsc_EQE": "J[ _]*[sₛ][c꜀][ _-]*EQE|EQE[- ]integrated J[ _]*[sₛ][c꜀]",
    "Jsc": "J[ _]*[sₛ][c꜀]|short[- ]circuit current density",
    "FF": "FF|fill factor",
    "Rs": "R[ _]?s(?:eries)?|series resistance",
    "Rsh": "R[ _]?sh(?:unt)?|shunt resistance",
    "HI": "HI|hysteresis index",
    "T80": "T[ _]?80",
    "Eg": "E[ _]?g|band gap|bandgap"
  },
  "normalization": {
    "PCE": {
      "target": "%",
