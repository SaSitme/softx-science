  "rules": {
    "PCE_CONSISTENCY": {
      "name": "Согласованность КПД",
      "relative_threshold": 0.03,
      "denominator": "abs(PCE_calc)",
      "operator": ">"
    },
    "VOC_BANDGAP": {
      "name": "Напряжение холостого хода и ширина запрещённой зоны",
      "Voc": {
        "max_exclusive": "Eg/q"
      }
    },
    "PHYSICAL_RANGE": {
      "name": "Физические границы",
      "PCE": {
        "min": 0,
        "max": 100
      },
      "FF": {
        "min_exclusive": 0,
        "max": 100
      },
      "Jsc": {
        "max_abs": "Pin/Eg"
      }
    },
    "SHOCKLEY_QUEISSER": {
      "name": "Предел однопереходного элемента",
      "model": "AM1.5G detailed balance",
      "T_reference_K": 298.15
    },
    "EQE_JSC": {
      "name": "Плотность тока по EQE и ВАХ",
      "relative_threshold": 0.05,
      "denominator": "abs(Jsc_JV)",
      "operator": ">"
    },
    "BATCH_CHAMPION": {
      "name": "Лучший прибор и среднее по партии",
      "min_difference": 0,
      "max_difference": "spread_if_available"
    },
    "SCAN_ISOLATION": {
      "name": "Раздельность направлений развёртки",
