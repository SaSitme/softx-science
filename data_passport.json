      "target": "%",
      "factor_by_unit": {
        "%": 1
      }
    },
    "retained_PCE": {
      "target": "%",
      "factor_by_unit": {
        "%": 1
      }
    },
    "Voc": {
      "target": "V",
      "factor_by_unit": {
        "V": 1,
        "mV": 0.001
      }
    },
    "Jsc": {
      "target": "mA/cm²",
      "factor_by_unit": {
        "mA/cm²": 1,
        "A/m²": 0.1,
        "A/cm²": 1000
      }
    },
    "Jsc_EQE": {
      "target": "mA/cm²",
      "factor_by_unit": {
        "mA/cm²": 1,
        "A/m²": 0.1,
        "A/cm²": 1000
      }
    },
    "Eg": {
      "target": "eV",
